datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  TEACHER
  STUDENT
}

enum StudentStatus {
  PENDING
  APPROVED
  DECLINED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("STUDENT")
  status        String    @default("pending")

  // NextAuth relations
  accounts Account[]
  sessions Session[]

  // Section relation
  sectionId String?
  section   Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  // Meeting relation
  meetings Meeting[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Assignment {
  id                  String       @id @default(cuid())
  title               String
  description         String?
  subject             String       @default("General Learning")
  section             String
  studentId           String?
  studentName         String?
  attachmentUrl       String?
  completedStudentIds String[]     @default([])
  dueDate             String?
  status              String       @default("active")
  submissions         Submission[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model Submission {
  id            String     @id @default(cuid())
  assignmentId  String
  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId     String
  studentName   String
  attachmentUrl String?
  submittedAt   DateTime   @default(now())
}

model Section {
  id        String           @id @default(cuid())
  name      String           @unique
  students  User[]
  messages  SectionMessage[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model SectionMessage {
  id           String   @id @default(cuid())
  sectionId    String
  section      Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  senderEmail  String
  senderName   String
  senderRole   String // "TEACHER" or "STUDENT"
  senderAvatar String?
  text         String
  seenBy       String[] @default([])
  createdAt    DateTime @default(now())
}

model SectionTyping {
  id         String   @id @default(cuid())
  sectionId  String
  userEmail  String
  userName   String
  userAvatar String?
  updatedAt  DateTime @updatedAt

  @@unique([sectionId, userEmail])
}

model Meeting {
  id           String   @id @default(cuid())
  topic        String
  date         String
  time         String
  endTime      String
  meetLink     String
  status       String   @default("upcoming") // "upcoming" | "completed" | "cancelled"
  studentId    String?
  student      User?    @relation(fields: [studentId], references: [id], onDelete: SetNull)
  studentName  String?
  studentEmail String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
